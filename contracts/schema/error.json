{
  "description": "Unified error body returned by facade exception handlers.",
  "properties": {
    "code": {
      "description": "Machine-readable error code",
      "enum": [
        "not_found",
        "unsupported",
        "stale",
        "invalid_id",
        "rate_limited",
        "unauthorized",
        "validation_error",
        "not_implemented",
        "dependency_unavailable",
        "upstream_error",
        "internal_error"
      ],
      "title": "Code",
      "type": "string"
    },
    "message": {
      "description": "Human-readable explanation",
      "title": "Message",
      "type": "string"
    },
    "detail": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional structured detail",
      "title": "Detail"
    },
    "market": {
      "anyOf": [
        {
          "enum": [
            "CN",
            "US",
            "CRYPTO",
            "POLY"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional market context",
      "title": "Market"
    },
    "capability": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional capability e.g. watch|query|analyze|screen|prediction",
      "title": "Capability"
    }
  },
  "required": [
    "code",
    "message"
  ],
  "title": "ErrorBody",
  "type": "object"
}
