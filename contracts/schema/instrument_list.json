{
  "$defs": {
    "Instrument": {
      "properties": {
        "as_of": {
          "description": "UTC ISO8601 timestamp when data was observed/produced",
          "title": "As Of",
          "type": "string"
        },
        "source": {
          "description": "Upstream or synthetic source identifier",
          "title": "Source",
          "type": "string"
        },
        "stale": {
          "default": false,
          "description": "True if served past preferred freshness",
          "title": "Stale",
          "type": "boolean"
        },
        "symbol": {
          "description": "Canonical id e.g. CN:600519",
          "title": "Symbol",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "market": {
          "enum": [
            "CN",
            "US",
            "CRYPTO",
            "POLY"
          ],
          "title": "Market",
          "type": "string"
        },
        "exchange": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "asset_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Class"
        },
        "active": {
          "default": true,
          "title": "Active",
          "type": "boolean"
        }
      },
      "required": [
        "as_of",
        "source",
        "symbol",
        "name",
        "market"
      ],
      "title": "Instrument",
      "type": "object"
    }
  },
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/Instrument"
      },
      "title": "Items",
      "type": "array"
    },
    "total": {
      "title": "Total",
      "type": "integer"
    }
  },
  "required": [
    "items",
    "total"
  ],
  "title": "InstrumentList",
  "type": "object"
}
